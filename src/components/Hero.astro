---
import Portrait from './Portrait.astro';
import QRCode from 'qrcode';
import { site } from '../lib/site';
const qr = await QRCode.toString(site.github, {
  type: 'svg',
  width: 34,
  margin: 1,
  color: { dark: '#ffffff', light: '#070b15' },
});
---

<section data-aid="hero" class="relative overflow-hidden">
  <div class="mx-auto w-full max-w-[1100px] px-5 md:px-8 pt-14 md:pt-20 pb-14 md:pb-20 text-center">
    <div
      role="tablist"
      aria-label="Engineering focus"
      class="intro-seg inline-flex items-center bg-[#f1f1f2] rounded-full p-1 font-display font-medium text-[13px]"
    >
      <button
        class="hero-tab"
        type="button"
        role="tab"
        id="hero-fullstack-tab"
        aria-selected="true"
        aria-controls="hero-copy"
        data-hero-mode="fullstack"
      >
        Full-stack
      </button>
      <button
        class="hero-tab"
        type="button"
        role="tab"
        id="hero-mobile-tab"
        aria-selected="false"
        aria-controls="hero-copy"
        tabindex="-1"
        data-hero-mode="mobile"
      >
        Mobile
      </button>
    </div>
    <div id="hero-copy" role="tabpanel" aria-labelledby="hero-fullstack-tab">
      <h1
        data-aid="hero-title"
        class="intro-head display text-[44px] md:text-[64px] leading-[1.02] mt-7 md:mt-8 break-words"
      >
        Founding engineer.
        <br />
        Ships the whole stack.
      </h1>
      <p
        data-hero-summary
        class="intro-para text-[17px] leading-relaxed text-[#2c3140] mt-5 max-w-[640px] mx-auto"
      >
        Senior software engineer with 5+ years building production web and mobile products in
        TypeScript, Next.js, React Native and AWS. Architecture through delivery, then the on-call
        afterwards.
      </p>
      <a data-hero-cta href="#work" class="intro-para pill bg-ink text-white hover:bg-black mt-8">
        See selected work
      </a>
    </div>
  </div>

  <!-- NAVY BAND: wall of product UI -->
  <div data-aid="hero-band" class="intro-band relative bg-navy min-h-[460px] text-white">
    <div class="mx-auto w-full max-w-[1440px] px-4 md:px-6 pt-6 md:pt-8 pb-6 md:pb-24 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 font-mono text-[12px]">
      <!-- 1 ERA posting -->
      <div aria-hidden="true" class="ui-card p-4 min-h-[200px]">
        <div class="flex justify-between text-[10px] text-white/50 mb-3">
          <span>era · 835 posting</span>
          <span>USD</span>
        </div>
        <div class="scroll-x">
          <table class="w-full min-w-[240px] tnum">
            <thead class="text-[10px] text-white/40">
              <tr>
                <th class="text-left font-normal pb-1">claim</th>
                <th class="text-right font-normal">billed</th>
                <th class="text-right font-normal">paid</th>
              </tr>
            </thead>
            <tbody class="text-[11px]">
              <tr class="border-t border-white/10">
                <td class="py-1.5">CLM-88211</td>
                <td class="text-right">420.00</td>
                <td class="text-right">318.40</td>
              </tr>
              <tr class="border-t border-white/10">
                <td class="py-1.5">CLM-88214</td>
                <td class="text-right">1,150.00</td>
                <td class="text-right">1,150.00</td>
              </tr>
              <tr class="border-t border-white/10">
                <td class="py-1.5">CLM-88219</td>
                <td class="text-right">96.00</td>
                <td class="text-right text-coral">denied</td>
              </tr>
              <tr class="border-t border-warm/60 text-warm">
                <td class="py-1.5">posted</td>
                <td class="text-right">1,666.00</td>
                <td class="text-right">1,468.40</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- 2 Mobile CI terminal -->
      <div aria-hidden="true" class="ui-card p-4 min-h-[200px]">
        <div class="flex gap-1.5 mb-3">
          <span class="w-2 h-2 rounded-full bg-white/20"></span>
          <span class="w-2 h-2 rounded-full bg-white/20"></span>
          <span class="w-2 h-2 rounded-full bg-white/20"></span>
        </div>
        <div class="scroll-x">
          <pre class="text-[11px] leading-[1.6] text-white/80 min-w-[250px]"><span class="text-mint">$</span> eas build --profile production --platform all
→ ios · 7m48s · TestFlight ok
→ android · 6m31s · internal track ok
→ ota update · channel prod · 0.9 MB
→ automated checks · release gate
<span class="text-mint">✔</span> build → test → distribute</pre>
        </div>
      </div>

      <!-- 3 DB latency chart -->
      <div aria-hidden="true" class="ui-card p-4 min-h-[200px]">
        <div class="flex justify-between text-[10px] text-white/50 mb-2">
          <span>query plans · targeted indexing</span>
          <span class="text-mint">plan review</span>
        </div>
        <svg viewBox="0 0 240 120" class="w-full h-auto" aria-hidden="true">
          <g stroke="rgba(255,255,255,.08)">
            <line x1="0" y1="30" x2="240" y2="30" />
            <line x1="0" y1="60" x2="240" y2="60" />
            <line x1="0" y1="90" x2="240" y2="90" />
          </g>
          <text x="2" y="28" fill="rgba(255,255,255,.35)" font-size="8">
            400
          </text>
          <text x="2" y="58" fill="rgba(255,255,255,.35)" font-size="8">
            300
          </text>
          <text x="2" y="88" fill="rgba(255,255,255,.35)" font-size="8">
            200
          </text>
          <path
            d="M0 34 L20 38 L40 32 L60 40 L80 36 L100 44 L120 58 L140 70 L160 78 L180 84 L200 82 L220 88 L240 86"
            fill="none"
            stroke="#2fbf8f"
            stroke-width="2"
          />
          <path
            d="M0 34 L20 38 L40 32 L60 40 L80 36 L100 44 L120 58 L140 70 L160 78 L180 84 L200 82 L220 88 L240 86 L240 120 L0 120Z"
            fill="rgba(47,191,143,.12)"
          />
          <line
            x1="110"
            y1="0"
            x2="110"
            y2="120"
            stroke="rgba(255,255,255,.2)"
            stroke-dasharray="3 3"
          />
          <text x="114" y="110" fill="rgba(255,255,255,.4)" font-size="8">
            idx deployed
          </text>
        </svg>
      </div>

      <!-- 4 RCM copilot -->
      <div aria-hidden="true" class="ui-card p-4 min-h-[200px]">
        <div class="flex justify-between text-[10px] text-white/50 mb-3">
          <span>rcm copilot · bedrock</span>
          <span class="text-sun">needs review</span>
        </div>
        <div class="font-body text-[12px] leading-[1.7] text-white/80">
          <p>Policy evidence · human review</p>
          <p>
            A source-linked summary surfaces{' '}
            <span class="bg-mint/30 px-0.5">relevant documentation</span> for a reviewer.
          </p>
          <p>Next: verify applicability and supporting evidence.</p>
          <p class="text-white/40">— illustrative interface · sensitive-data safeguards</p>
        </div>
      </div>

      <!-- 5 Claim status -->
      <div aria-hidden="true" class="ui-card p-4 min-h-[200px]">
        <div class="flex justify-between gap-2 text-[10px] text-white/50 mb-3">
          <span class="truncate">claim · CLM-88214 · 837P</span>
          <span class="shrink-0">BCBS</span>
        </div>
        <div class="tnum text-[11px] space-y-1.5">
          <div class="flex justify-between gap-2">
            <span class="text-white/70 truncate">Eligibility · 270/271</span>
            <span class="shrink-0 text-mint">active</span>
          </div>
          <div class="flex justify-between">
            <span class="text-white/70">Scrub · CMS-1500</span>
            <span class="text-mint">0 edits</span>
          </div>
          <div class="flex justify-between">
            <span class="text-white/70">999 / 277CA</span>
            <span class="text-mint">accepted</span>
          </div>
          <div class="flex justify-between border-t border-white/10 pt-1.5 font-semibold">
            <span>ERA 835</span>
            <span>$1,150.00</span>
          </div>
        </div>
        <div class="mt-3 h-1.5 rounded-full bg-white/10 overflow-hidden">
          <div class="h-full w-full bg-sun"></div>
        </div>
        <div class="text-[10px] text-white/40 mt-1">eligibility → acknowledgments → posting</div>
      </div>

      <!-- 6 Crash-free sessions -->
      <div aria-hidden="true" class="ui-card p-4 min-h-[200px]">
        <div class="flex justify-between gap-2 text-[10px] text-white/50 mb-2">
          <span class="truncate">mobile reliability · illustrative</span>
          <span class="shrink-0 text-mint">release health</span>
        </div>
        <div class="flex items-end gap-1 h-16">
          <div class="flex-1 bg-coral/70 rounded-sm" style="height:40%"></div>
          <div class="flex-1 bg-coral/70 rounded-sm" style="height:44%"></div>
          <div class="flex-1 bg-coral/70 rounded-sm" style="height:38%"></div>
          <div class="flex-1 bg-sun rounded-sm" style="height:55%"></div>
          <div class="flex-1 bg-mint/70 rounded-sm" style="height:66%"></div>
          <div class="flex-1 bg-mint/70 rounded-sm" style="height:72%"></div>
          <div class="flex-1 bg-mint/70 rounded-sm" style="height:78%"></div>
          <div class="flex-1 bg-mint/70 rounded-sm" style="height:84%"></div>
          <div class="flex-1 bg-mint/70 rounded-sm" style="height:88%"></div>
          <div class="flex-1 bg-mint/70 rounded-sm" style="height:90%"></div>
          <div class="flex-1 bg-mint/70 rounded-sm" style="height:94%"></div>
          <div class="flex-1 bg-mint/70 rounded-sm" style="height:96%"></div>
        </div>
        <div class="flex justify-between text-[10px] mt-2 tnum">
          <span class="text-white/50">crashes −34%</span>
          <span class="text-white/50">v4.12 · perf release</span>
        </div>
      </div>

      <!-- 7 PHI masking diff -->
      <div aria-hidden="true" class="ui-card p-4 min-h-[200px]">
        <div class="flex justify-between text-[10px] text-white/50 mb-3">
          <span>#217 lib/logger.ts</span>
          <span class="text-mint">+5 −1</span>
        </div>
        <div class="scroll-x">
          <pre class="text-[11px] leading-[1.6] min-w-[250px]"><span class="text-white/40">  export function logVisit(v) &#123;</span>
<span class="bg-coral/25 text-coral">-   logger.info('visit', v)</span>
<span class="bg-mint/25 text-mint">+   const safe = maskPhi(v, &#123;</span>
<span class="bg-mint/25 text-mint">+     fields: ['name','dob','mrn'],</span>
<span class="bg-mint/25 text-mint">+   &#125;)</span>
<span class="bg-mint/25 text-mint">+   logger.info('visit', safe)</span>
<span class="text-white/40">  &#125;</span></pre>
        </div>
      </div>

      <!-- 8 Mobile video visit -->
      <div aria-hidden="true" class="ui-card p-4 min-h-[200px] flex justify-center">
        <div class="w-[120px] bg-white text-ink rounded-xl p-3 font-body shadow-lg">
          <div class="text-[9px] text-[#6b6f78]">Today · 2:30 PM</div>
          <div class="font-display font-bold text-[12px] mt-1">Video visit</div>
          <div class="mt-2 aspect-[4/3] rounded-md bg-gradient-to-br from-[#dde3f0] to-[#c9d2e6] flex items-end p-1.5">
            <span class="text-[8px] font-mono text-[#5b6886]">Dr. Patel · online</span>
          </div>
          <div class="mt-2 h-7 rounded-full bg-cobalt text-white text-[10px] flex items-center justify-center font-medium">
            Join visit
          </div>
        </div>
      </div>
    </div>

    <p class="absolute bottom-3 left-6 font-mono text-[10px] text-white/70">
      Illustrative product interfaces · synthetic data
    </p>
    <!-- Portrait card -->
    <div
      data-aid="hero-portrait"
      class="relative lg:absolute lg:left-1/2 lg:top-1/2 lg:-translate-x-1/2 lg:-translate-y-1/2 mx-auto mb-8 lg:mb-0 w-[calc(100%-32px)] max-w-[300px] lg:w-[320px] lg:max-w-none bg-white rounded-2xl p-3 text-ink shadow-[0_40px_80px_-30px_rgba(0,0,0,.6)]"
    >
      <div class="aspect-[3/4] rounded-xl bg-[#eef1f8] overflow-hidden">
        <Portrait hero />
      </div>
      <div class="px-1 pt-3 pb-1">
        <div class="display text-[20px] tracking-[-0.02em]">Michael Dadi</div>
        <div class="text-[13px] text-[#6b6f78] mt-0.5">Senior software engineer · New York</div>
      </div>
    </div>

    <!-- QR chip -->
    <a
      href="https://github.com/michaeldadi"
      class="md:absolute md:right-6 md:bottom-6 mx-auto mb-6 md:mb-0 w-max bg-ink rounded-lg p-2 flex items-center gap-2 hover:bg-black"
    >
      <span aria-hidden="true" set:html={qr} />
      <span class="font-mono text-[11px] text-white">github.com/michaeldadi</span>
    </a>
  </div>
</section>
