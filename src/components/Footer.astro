---
import { site, formatDate } from '../lib/site';
---

<footer data-aid="footer" class="border-t border-hair">
  <div class="mx-auto w-full max-w-[1280px] px-5 md:px-8 min-h-14 flex flex-col md:flex-row items-center justify-between gap-2 font-mono text-[12px] text-[#606570] py-4">
    <span>© {new Date(site.updated).getUTCFullYear()} Michael Dadi</span>
    <span class="text-center">
      built with care ·{' '}
      <a class="underline underline-offset-4" href="/privacy/">
        analytics &amp; privacy
      </a>{' '}
      · updated {formatDate(site.updated)}
    </span>
  </div>
</footer>
