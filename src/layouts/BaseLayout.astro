---
import outfitFont from '@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  article?: { publishedAt: string; modifiedAt: string };
}
const {
  title = site.title,
  description = site.description,
  noindex = false,
  article,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const production = import.meta.env.DEPLOY_ENV === 'production';
const analytics = production ? import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN : '';
const schema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      datePublished: article.publishedAt,
      dateModified: article.modifiedAt,
      author: { '@type': 'Person', name: site.name, url: site.url },
      mainEntityOfPage: canonical,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: site.name,
      url: site.url,
      jobTitle: 'Senior Software Engineer',
      sameAs: [site.github, site.linkedin],
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#012991" />
    <meta name="robots" content={noindex || !production ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={outfitFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Michael Dadi — Engineering notes"
      href="/rss.xml"
    />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/social.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}/social.png`} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    {analytics && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analytics })}
      ></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
