---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — Michael Dadi"
  description="This page could not be found. Return to Michael Dadi’s portfolio."
  noindex
>
  <section class="mx-auto max-w-[1100px] px-5 md:px-8 py-24 md:py-36">
    <p class="eyebrow text-[#626773] mb-6">404 · page not found</p>
    <h1 class="display text-[48px] md:text-[72px] leading-[1.02]">
      A dead end.
      <br />A clear way back.
    </h1>
    <p class="mt-6 max-w-[480px] text-lg text-[#2c3140] leading-relaxed">
      The page may have moved, or the address may be incomplete. The work is still here.
    </p>
    <a href="/" class="pill bg-ink text-white mt-8">
      Back to the portfolio
    </a>
  </section>
</BaseLayout>
